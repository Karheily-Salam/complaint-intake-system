# Copy to backend/.env and adjust. Never commit backend/.env.

# ---- Application ----
APP_NAME="Complaint Intake System"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Database ----
# SQLite for the prototype. Swap for a postgresql+psycopg URL in production.
# A relative sqlite:/// path is resolved against backend/ regardless of the
# working directory the process was started from - see app/core/db_path.py.
DATABASE_URL=sqlite:///./complaint_intake.db
# Set true to log every SQL statement.
DB_ECHO=false
# Automatically run pending Alembic migrations on startup (convenient for this
# local prototype: a fresh clone works with no manual init step). For a real
# deployment set this to false and run `alembic upgrade head` as an explicit
# release step instead.
RUN_MIGRATIONS_ON_STARTUP=true

# ---- CORS (frontend dev server) ----
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ---- AI provider ----
# Options: rule_based | ollama
AI_PROVIDER=rule_based
# Used only when AI_PROVIDER=ollama. No paid API. Runs locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=60
# If Ollama is unreachable: true = fall back to rule_based, false = raise an error.
OLLAMA_FALLBACK_TO_RULE_BASED=true

# ---- Conversation engine ----
# Classifier confidence below which the engine asks the customer to clarify the type.
MIN_CLASSIFICATION_CONFIDENCE=0.45

# ---- Email provider ----
# Options:
#   mock      - no real mailbox; the local /inbox simulator drives the flow
#   imap_smtp - real customer email: IMAP polling in, SMTP out
EMAIL_PROVIDER=mock
# Where a completed ticket is emailed (the support/admin team's own inbox).
SUPPORT_INBOX_ADDRESS=complaints@example.com
# Domain used in the Message-IDs we generate. It never has to resolve, but the
# real sending domain is the correct value.
MAIL_DOMAIN=example.com

# ---- Real email (only needed when EMAIL_PROVIDER=imap_smtp) ----
# Use a DEDICATED mailbox for complaints, and an app password rather than the
# account's own password. Never commit real values: this file is the example,
# the filled-in copy lives only in backend/.env (git-ignored) on the server.
# Startup fails fast, naming any variable that is missing (never its value).
#
# Inbound (IMAP polling)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USERNAME=complaints@yourdomain.com
# IMAP_PASSWORD=
# IMAP_USE_SSL=true
# IMAP_MAILBOX=INBOX
# EMAIL_POLL_INTERVAL_SECONDS=60
#
# Outbound (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=complaints@yourdomain.com
# SMTP_PASSWORD=
# SMTP_USE_SSL=false   # true = implicit TLS on connect (port 465)
# SMTP_USE_TLS=true    # true = STARTTLS after connecting (port 587)
# SMTP_FROM_ADDR=complaints@yourdomain.com   # defaults to SUPPORT_INBOX_ADDRESS


# =============================================================================
# Production (Docker) - values used by compose.yml on the VPS.
# Copy this file to backend/.env on the server and replace the section above
# with these. Never commit backend/.env.
# =============================================================================
# ENVIRONMENT=production
# DEBUG=false
# API_V1_PREFIX=/api/v1
#
# Absolute path inside the container, backed by the "backend_data" volume.
# DATABASE_URL=sqlite:////app/data/complaint_intake.db
# DB_ECHO=false
#
# The stack runs migrations on startup for this single-container prototype
# deployment. Set to false only if you add a dedicated migrate step.
# RUN_MIGRATIONS_ON_STARTUP=true
#
# Requests reach FastAPI same-origin via the Nginx /api/ proxy, so CORS is not
# strictly needed; listed here as the honest production origin.
# BACKEND_CORS_ORIGINS=["http://72.56.114.70"]
#
# AI_PROVIDER=rule_based
# MIN_CLASSIFICATION_CONFIDENCE=0.45
#
# Email: stays "mock" until a real complaints mailbox exists. Switching to
# imap_smtp needs the IMAP_*/SMTP_* block above filled in on the server only -
# see the "Going live with real email" section in DEPLOYMENT.md.
# EMAIL_PROVIDER=mock
# SUPPORT_INBOX_ADDRESS=complaints@yourdomain.com
# MAIL_DOMAIN=yourdomain.com
