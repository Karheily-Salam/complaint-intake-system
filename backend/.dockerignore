# Build context hygiene - keep the image lean and never ship local state/secrets.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local databases - the container uses its own volume at /app/data.
*.db
*.sqlite3

# Secrets / local env - provided at runtime via compose env_file.
.env
.env.*
!.env.example

# Tests are not needed inside the runtime image (they run in CI / locally).
tests/

README.md
